# ---------- App ----------
NEXT_PUBLIC_APP_URL=https://leadscollectors.vercel.app
NEXT_PUBLIC_TIMEZONE=Asia/Kolkata

# ---------- Supabase (Project Settings -> API) ----------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# SERVER ONLY. Never expose to the browser, never commit.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------- Secrets (generate each one separately) ----------
# openssl rand -base64 32
ENCRYPTION_KEY=
# openssl rand -hex 32
CRON_SECRET=
# openssl rand -hex 32
IP_HASH_SALT=

# ---------- Email (Resend) ----------
RESEND_API_KEY=
EMAIL_FROM=Leadscollector <alerts@yourdomain.com>

# ---------- Google Sheets (separate OAuth client from Supabase Google login) ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_SHEETS_REDIRECT_URI=https://leadscollectors.vercel.app/api/integrations/google/callback

# ---------- Spam protection (optional) ----------
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---------- Stripe (optional, billing scaffold) ----------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=

# ---------- Dev only ----------
# Set to 1 to expose /test-forms and /api/test/* in production builds (not recommended)
ENABLE_TEST_FORMS=
